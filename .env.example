# Copiar a .env (chmod 600) y completar. El archivo .env NO se versiona.

# --- Base de datos -----------------------------------------------------------
POSTGRES_USER=impresiones
POSTGRES_PASSWORD=cambiar-esto
POSTGRES_DB=misimpresiones
DB_PORT=5433
DATABASE_URL=postgresql+asyncpg://impresiones:cambiar-esto@db:5432/misimpresiones

# --- Seguridad ---------------------------------------------------------------
# Obligatoria en producción. Generar con: openssl rand -hex 32
SECRET_KEY=
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
# Vacío = se decide por petición (X-Forwarded-Proto). true/false lo fuerza.
COOKIE_SECURE=
# 1 detrás del Worker/túnel: confía en X-Real-Client-IP SOLO si llega con el secreto compartido.
TRUST_PROXY=0
# Secreto que el Worker añade a cada petición (cabecera x-proxy-secret). Generar: openssl rand -hex 24
# Si está puesto, el frontend rechaza (403) lo que no lo traiga: la URL trycloudflare directa deja de servir.
PROXY_SHARED_SECRET=

# --- Administrador (único usuario) -------------------------------------------
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Aplicación ----------------------------------------------------------------
APP_ENV=development
APP_TIMEZONE=America/Bogota
BACKEND_PORT=8100
FRONTEND_PORT=3100
MEDIA_DIR=/media
MAX_UPLOAD_MB=12
# --- Cloudflare Turnstile (el «reCAPTCHA» de Cloudflare: login y pedidos del catálogo) -----------
# Panel de Cloudflare → Turnstile → Add widget → hostname = el de la app (p. ej. misimpresiones.<tu-subdominio>.workers.dev).
# SITEKEY es pública; SECRETKEY es secreta. Vacías = Turnstile apagado. En desarrollo se usan llaves de
# prueba automáticas (docker-compose.yml); para probar con las reales: TURNSTILE_SITEKEY_DEV / TURNSTILE_SECRETKEY_DEV.
TURNSTILE_SITEKEY=
TURNSTILE_SECRETKEY=
# Número de WhatsApp del negocio (solo dígitos, con indicativo). Opcional: lo usa el catálogo público.
WHATSAPP_NEGOCIO=
APP_UID=1000
APP_GID=1000
# MIGRAR_AL_ARRANCAR=0 apaga la migración automática.

# --- Cloudflare (solo para publicar el Worker; NUNCA versionar valores reales) ---
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
WORKER_NOMBRE=misimpresiones

# --- Impresora Bambu Lab A1 ---------------------------------------------------
# La IP, el serial, el código de acceso y la cuenta de Bambu Cloud se configuran en el panel:
# Administración → Conexión (quedan cifrados en la base con SECRET_KEY). NO hace falta ponerlos aquí.
# BAMBU_IP / BAMBU_SERIAL / BAMBU_ACCESS_CODE solo se leen UNA vez, si la base aún no tiene
# configuración, para importar lo que ya usabas; después puedes borrarlos.
BAMBU_IP=
BAMBU_SERIAL=
BAMBU_ACCESS_CODE=
# Redes permitidas para la IP de la impresora (CIDR separados por coma, p. ej. 10.0.4.0/24). Vacío = cualquier
# red privada salvo 172.16.0.0/12 (las redes internas de Docker).
# BAMBU_REDES_PERMITIDAS=
# Días de historial de Bambu Cloud que se traen:
BAMBU_NUBE_DIAS=7

# Nombre que se muestra en el catálogo público
NOMBRE_NEGOCIO="Mis impresiones"

# --- Spoolman (inventario de bobinas de filamento) ---------------------------------------------
# Spoolman NO tiene autenticación: solo se publica en la IP de WireGuard del servidor y el cortafuegos
# deja pasar únicamente la LAN de casa (ver docs/spoolman.md). NUNCA pongas 0.0.0.0.
# IP en la que se publica (127.0.0.1 = solo el propio servidor):
SPOOLMAN_BIND_IP=127.0.0.1
# SPOOLMAN_PORT=7912
# Enlace «Abrir Spoolman» que muestra el panel (desde casa): http://<IP de wg0>:7912
SPOOLMAN_WEB=
# Cómo le hablan el backend y el servicio de la impresora (por la red interna de Docker):
# SPOOLMAN_URL=http://spoolman:8000   (vacío = integración apagada)
# Registrar solas en Spoolman las bobinas Bambu con chip RFID que aparezcan en el AMS (0 = apagado):
# SPOOLMAN_AUTOCREAR=
# Unir solos los rollos SIN chip a su bobina de Spoolman cuando hay una única candidata del mismo material y color (0 = apagado):
# SPOOLMAN_AUTOVINCULAR=1
